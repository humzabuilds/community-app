{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  "vars": {
    // "development" turns on the dev outbox at /dev/outbox. Set to "production" when you deploy.
    "ENVIRONMENT": "development",
    // "console" logs mail locally. See the README for "resend" and "relay".
    "EMAIL_PROVIDER": "console",
    "ADMIN_EMAIL": "you@example.com",
    "APP_URL": "http://localhost:8787"
    // Optional paid tier: "PLUS_LINK": "<your Stripe Payment Link>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community",
      // Replace with the id that `wrangler d1 create community` prints.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
